{
  "name": "@company/business-table",
  "version": "1.0.0-rc.7",
  "private": false,
  "type": "module",
  "description": "Configuration-driven enterprise Vue 3 business table component",
  "license": "UNLICENSED",
  "main": "dist/business-table.umd.cjs",
  "module": "dist/business-table.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/business-table.js",
      "require": "./dist/business-table.umd.cjs"
    },
    "./style.css": "./dist/business-table.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "build:lib": "npm run type-check && npm run build:types && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "audit:portability": "node scripts/portability-audit.mjs",
    "audit:sfc": "node scripts/sfc-syntax-audit.mjs",
    "test:e2e": "playwright test",
    "verify:release": "npm run audit:portability && npm run audit:sfc && npm run type-check && npm run test && npm run build && npm run test:e2e"
  },
  "peerDependencies": {
    "vue": ">=3.5.43 <4",
    "vxe-table": ">=4.21.10 <5"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@vxe-ui/core": "^4.4.24",
    "dom-zindex": "^1.0.7",
    "xe-utils": "^4.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.11",
    "@types/node": "^26.0.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.10",
    "vue": "3.5.43",
    "vue-tsc": "^3.3.11",
    "vxe-table": "4.21.10",
    "jsdom": "30.1.0",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.17.1"
}
