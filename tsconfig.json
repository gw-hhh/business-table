{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@company/business-table/runtime": [
        "./src/entries/runtime.ts"
      ],
      "@company/business-table/components": [
        "./src/entries/components.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "demo/**/*.ts",
    "demo/**/*.vue",
    "tests/**/*.ts",
    "vite*.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
