{
  "name": "quotation-manager-refactor",
  "version": "3.1.0",
  "private": true,
  "description": "Offline quotation management demo with testable vanilla JavaScript modules",
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test tests/*.test.cjs",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test:browser": "python3 tests/browser_test.py",
    "test:icons": "python3 tests/column_icons_test.py",
    "test:all": "npm test && npm run build && npm run test:browser && npm run test:icons && npm run test:custom && npm run test:enhanced && npm run test:polish",
    "test:custom": "python3 tests/customization_browser_test.py",
    "test:workbooks": "python3 tests/verify_workbooks.py",
    "test:navigation": "python3 tests/navigation_test.py",
    "test:enhanced": "python3 tests/enhancements_browser_test.py",
    "test:polish": "python3 tests/polish_browser_test.py",
    "test:visual": "python3 tests/polish_screenshots.py",
    "test:workbooks:portable": "python3 tests/verify_workbooks_openpyxl.py"
  },
  "engines": {
    "node": ">=18"
  }
}
